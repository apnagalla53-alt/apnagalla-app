# Inject actual values from a secret manager. This template cannot start production.
NODE_ENV=production
PORT=8010
DATABASE_URL=
JWT_SECRET=
PLATFORM_JWT_SECRET=
MFA_ENCRYPTION_KEY=
# Random 32-byte base64 encryption key; preserve it separately for recovery.
# Platform MFA is mandatory; there is no production bypass.
# List only the actual trusted ingress addresses, not all/private networks.
TRUSTED_PROXY_CIDRS=loopback
TENANT_UPLOAD_QUOTA_BYTES=1073741824
FRONTEND_ORIGIN=https://app.apnagalla.in
WEBSITE_ORIGIN=https://apnagalla.in
# With both clients using https://api.apnagalla.in, leave cookies host-only.
# RETAIL_COOKIE_DOMAIN=  # Optional parent-domain cookie mode for same-origin proxy deployments.
API_ORIGIN=https://api.apnagalla.in
APP_VERSION=
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Server-only credentials. Authenticated uploads; no unsigned browser upload preset.
# Database backups must use a separate backup provider, not Cloudinary.
S3_BUCKET=
S3_REGION=
# Use workload IAM credentials; do not embed access keys in source.
# S3_ENDPOINT=      # Optional compatible object storage endpoint
# S3_FORCE_PATH_STYLE=false
# S3_KMS_KEY_ID=    # Optional customer managed key
# Local persistent storage alternative: STORAGE_PROVIDER=local and UPLOAD_DIR=/private/erp-uploads
BACKUP_PROVIDER=none
# Switch to s3 only after supplying a private bucket, IAM and retention policy.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=evolix-backups/
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=
# BACKUP_S3_ENDPOINT=        # Optional compatible HTTPS endpoint
# BACKUP_S3_KMS_KEY_ID=
BACKUP_DIRECTORY=./.local-backups
# BACKUP_ALERT_WEBHOOK_URL= # Private HTTPS operator alert; optional
# AWS_ACCESS_KEY_ID=        # Prefer workload identity. Otherwise secret manager only.
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# No production browser restore target. Use the disaster-recovery runbook.
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
PUBLIC_APP_URL=https://app.apnagalla.in
# Public OAuth client ID, not a client secret. Empty hides Google sign-in.
GOOGLE_CLIENT_ID=
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Configure either a messaging service or a registered sender.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
ANDROID_APP_ENABLED=false
# SMS remains unavailable until configured and verified in staging. WhatsApp,
# online subscription payments and external error tracking are not configured.
