# Development only. Use .env.production.example for production.
NODE_ENV=development
PORT=8010
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/evolix_trade_dev
JWT_SECRET=
PLATFORM_JWT_SECRET=
MFA_ENCRYPTION_KEY=
# Generate a random 32-byte base64 key when Platform authenticator verification is enabled.
PLATFORM_MFA_REQUIRED=true
# Explicitly set false for local development password-only login. Production rejects false.
TRUSTED_PROXY_CIDRS=loopback
TENANT_UPLOAD_QUOTA_BYTES=1073741824
FRONTEND_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8010
STORAGE_PROVIDER=local
UPLOAD_DIR=./storage/uploads
BACKUP_PROVIDER=none
APP_VERSION=development
GOOGLE_CLIENT_ID=
EMAIL_PROVIDER=none
SMS_PROVIDER=none
# Populate only in ignored environment files or a hosting secret manager.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
PUBLIC_APP_URL=http://localhost:5173
ANDROID_APP_ENABLED=false
# No automatic administrator creation unless explicitly set locally.
# TENANT_BOOTSTRAP_PASSWORD=
# PLATFORM_BOOTSTRAP_PASSWORD=

# Universal Intake: API only queues; run npm run intake:worker separately.
INTAKE_OCR_ENABLED=false
INTAKE_OCR_LANGUAGES=eng+hin
INTAKE_OCR_CACHE=.ocr-cache
# Optional self-hosted traineddata directory/URL; documents stay in your worker.
INTAKE_OCR_LANG_PATH=
