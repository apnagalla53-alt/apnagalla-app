  @@map("return_reasons")
}

model Claim {
  id              String   @id @default(uuid()) @db.Uuid
  company_id      String   @db.Uuid
  branch_id       String   @db.Uuid
  party_id        String   @db.Uuid
  claim_type      String   @db.VarChar(50) // 'CUSTOMER_CLAIM', 'SUPPLIER_CLAIM'
  document_number String   @db.VarChar(100)
  document_date   DateTime @db.Date
  status          String   @db.VarChar(50) // 'OPEN', 'UNDER_REVIEW', 'APPROVED', 'REJECTED', 'SETTLED', 'CLOSED'
  reason_id       String?  @db.Uuid
  notes           String?  @db.Text
  total_amount    Decimal  @default(0) @db.Decimal(15, 6)

  // Linkages to origin documents where applicable
  sales_invoice_id    String? @db.Uuid
  purchase_invoice_id String? @db.Uuid
  sales_return_id     String? @db.Uuid
  purchase_return_id  String? @db.Uuid

  created_by  String?   @db.Uuid
  approved_by String?   @db.Uuid
  approved_at DateTime? @db.Timestamptz
  settled_by  String?   @db.Uuid
  settled_at  DateTime? @db.Timestamptz
  created_at  DateTime  @default(now()) @db.Timestamptz
  updated_at  DateTime  @updatedAt @db.Timestamptz

  company  Company       @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch   Branch        @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  party    Party         @relation(fields: [party_id], references: [id], onDelete: Restrict)
  reason   ReturnReason? @relation(fields: [reason_id], references: [id], onDelete: Restrict)
  creator  User?         @relation("ClaimCreator", fields: [created_by], references: [id], onDelete: SetNull)
  approver User?         @relation("ClaimApprover", fields: [approved_by], references: [id], onDelete: SetNull)
  settler  User?         @relation("ClaimSettler", fields: [settled_by], references: [id], onDelete: SetNull)

  // Back references to source documents
  sales_invoice    SalesInvoice?    @relation(fields: [sales_invoice_id], references: [id], onDelete: SetNull)
  purchase_invoice PurchaseInvoice? @relation(fields: [purchase_invoice_id], references: [id], onDelete: SetNull)
  sales_return     SalesReturn?     @relation(fields: [sales_return_id], references: [id], onDelete: SetNull)
  purchase_return  PurchaseReturn?  @relation(fields: [purchase_return_id], references: [id], onDelete: SetNull)

  lines  ClaimLine[]
  events ClaimEvent[]

  @@unique([company_id, document_number])
  @@index([party_id])
  @@index([status])
  @@map("claims")
}

model ClaimLine {
  id       String  @id @default(uuid()) @db.Uuid
