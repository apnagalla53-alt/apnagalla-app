generator client {
  provider = "prisma-client-js"
}

// Assistant stores operational questions/context only; never financial responses.
model AssistantIntentConfig {
  code String @id @db.VarChar(60)
  active Boolean @default(true)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz
  @@map("assistant_intent_configs")
}

model AssistantExample {
  id String @id @default(uuid()) @db.Uuid
  intent_code String @db.VarChar(60)
  phrase String @db.VarChar(400)
  normalized String @unique @db.VarChar(400)
  language String @db.VarChar(20)
  source String @default("DEFAULT") @db.VarChar(30)
  active Boolean @default(true)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz
  @@index([intent_code,active])
  @@map("assistant_examples")
}

model AssistantConversation {
  id String @id @default(uuid()) @db.Uuid
  company_id String @db.Uuid
  branch_id String @db.Uuid
  user_id String @db.Uuid
  auth_session_id String @db.Uuid
  context Json @default("{}") @db.JsonB
  version Int @default(0)
  expires_at DateTime @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz
  company Company @relation(fields:[company_id],references:[id],onDelete:Cascade)
  branch Branch @relation(fields:[branch_id],references:[id],onDelete:Cascade)
  user User @relation(fields:[user_id],references:[id],onDelete:Cascade)
  @@index([company_id,user_id,expires_at])
  @@index([expires_at])
  @@map("assistant_conversations")
}

model AssistantQueryLog {
  id String @id @default(uuid()) @db.Uuid
  company_id String @db.Uuid
  branch_id String @db.Uuid
  user_id String @db.Uuid
  original_message String @db.VarChar(400)
  normalized_message String @db.VarChar(400)
  intent_code String? @db.VarChar(60)
  confidence Float?
  router_type String @db.VarChar(20)
  status String @db.VarChar(30)
  timings Json @db.JsonB
  total_ms Float
  created_at DateTime @default(now()) @db.Timestamptz
  company Company @relation(fields:[company_id],references:[id],onDelete:Cascade)
  branch Branch @relation(fields:[branch_id],references:[id],onDelete:Cascade)
  user User @relation(fields:[user_id],references:[id],onDelete:Cascade)
  @@index([created_at,status])
  @@index([company_id,created_at])
  @@index([intent_code,created_at])
  @@map("assistant_query_logs")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity Models ─────────────────────────────────────────────────────────

model User {
  referral_codes ReferralCode[]
  referral_signup ReferralAttribution?
  assistant_queries AssistantQueryLog[]
  assistant_conversations AssistantConversation[]
  import_jobs RetailImportJob[]
  report_preferences RetailReportPreference[]
  report_notifications RetailReportNotification[]
  migration_choices RetailMigrationChoice[]
  data_backup_requests RetailDataBackupRequest[]
  id                 String    @id @default(uuid()) @db.Uuid
  organization_id    String?   @db.Uuid
  username           String    @unique @db.VarChar(255)
  display_name       String    @db.VarChar(255)
  email              String?   @db.VarChar(255)
  email_verified_at  DateTime? @db.Timestamptz
  phone              String?   @db.VarChar(50)
  password_hash      String    @db.VarChar(255)
  google_subject     String?   @unique @db.VarChar(255)
  phone_e164         String?   @unique @db.VarChar(20)
  phone_verified_at  DateTime? @db.Timestamptz
  password_login_enabled Boolean @default(true)
  onboarding_state   String @default("READY") @db.VarChar(40)
  onboarding_data    Json @default("{}") @db.JsonB
  must_change_password Boolean @default(false)
  temporary_password_expires_at DateTime? @db.Timestamptz
  password_changed_at DateTime? @db.Timestamptz
  is_active          Boolean   @default(true)
  is_locked          Boolean   @default(false)
  failed_login_count Int       @default(0)
  language           String    @default("en") @db.VarChar(10)
  last_login_at      DateTime? @db.Timestamptz
  last_active_at     DateTime? @db.Timestamptz
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz

  roles            UserRole[]
  sessions         Session[]
  password_history PasswordHistory[]
  auth_tokens      AuthToken[]

  goods_receipts           GoodsReceipt[]
  vouchers                 Voucher[]
  reversed_vouchers        Voucher[]         @relation("VoucherReversedBy")
  purchase_invoices        PurchaseInvoice[]
  purchase_returns         PurchaseReturn[]
  sales_quotations         SalesQuotation[]
  sales_orders             SalesOrder[]
  delivery_challans        DeliveryChallan[]
  sales_invoices           SalesInvoice[]
  sales_returns            SalesReturn[]
  audit_logs               AuditLog[]
  posted_stock_adjustments StockAdjustment[] @relation("StockAdjustmentPoster")
  posted_stock_transfers   StockTransfer[]   @relation("StockTransferPoster")
  posted_opening_stocks    OpeningStock[]    @relation("OpeningStockPoster")
  counted_stock_counts     StockCount[]      @relation("StockCountCounter")
  posted_stock_counts      StockCount[]      @relation("StockCountPoster")
  PosShift                 PosShift[]
  created_claims           Claim[]           @relation("ClaimCreator")
  approved_claims          Claim[]           @relation("ClaimApprover")
  settled_claims           Claim[]           @relation("ClaimSettler")
  claim_events             ClaimEvent[]
  need_lists               NeedList[]
  Attachment               Attachment[]
  Expense                  Expense[]

  @@map("users")
}

model AuthToken {
  id String @id @default(uuid()) @db.Uuid
  user_id String? @db.Uuid
  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)
  purpose String @db.VarChar(32)
  token_hash String @unique @db.VarChar(64)
  pending_email String? @db.VarChar(255)
  expires_at DateTime @db.Timestamptz
  used_at DateTime? @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz
  @@index([user_id, purpose])
  @@index([expires_at])
  @@map("auth_tokens")
}

model PrivacyRequest {
  id String @id @default(uuid()) @db.Uuid
  organization_id String @db.Uuid
  company_id String @db.Uuid
  user_id String @db.Uuid
  type String @db.VarChar(32)
  status String @default("PENDING") @db.VarChar(32)
  note String? @db.VarChar(2000)
  created_at DateTime @default(now()) @db.Timestamptz
  resolved_at DateTime? @db.Timestamptz
  @@index([organization_id, created_at])
  @@index([user_id, status])
  @@map("privacy_requests")
}

model Role {
  id              String  @id @default(uuid()) @db.Uuid
  organization_id String? @db.Uuid
  name            String  @db.VarChar(255)
  description     String? @db.Text
  system_role     Boolean @default(false)

  role_permissions RolePermission[]
  user_roles       UserRole[]

  @@unique([organization_id, name], name: "uix_roles_org_name")
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(255)
  module      String  @db.VarChar(50)
  resource    String  @db.VarChar(100)
  action      String  @db.VarChar(100)
  description String? @db.Text

  role_permissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  user_id    String  @db.Uuid
  role_id    String  @db.Uuid
  company_id String? @db.Uuid
  branch_id  String? @db.Uuid

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("user_roles")
}

model RolePermission {
  role_id       String @db.Uuid
  permission_id String @db.Uuid
  scope         String @default("ALL_COMPANIES") @db.VarChar(50)

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  device_id  String?   @db.VarChar(255)
  issued_at  DateTime  @default(now()) @db.Timestamptz
  expires_at DateTime  @db.Timestamptz
  revoked_at DateTime? @db.Timestamptz
  ip_address String?   @db.VarChar(45)
  user_agent String?   @db.VarChar(512)
  last_active_at DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PasswordHistory {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  password_hash String   @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("password_history")
}

// ── Platform Identity Models ─────────────────────────────────────────────────

model PlatformUser {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique @db.VarChar(255)
  display_name       String    @db.VarChar(255)
  email              String?   @db.VarChar(255)
  phone              String?   @db.VarChar(50)
  password_hash      String    @db.VarChar(255)
  mfa_secret_encrypted String? @db.Text
  mfa_enabled_at DateTime? @db.Timestamptz
  mfa_last_counter BigInt?
  mfa_recovery_hashes String[] @default([])
  is_active          Boolean   @default(true)
  is_locked          Boolean   @default(false)
  failed_login_count Int       @default(0)
  last_login_at      DateTime? @db.Timestamptz
  last_active_at     DateTime? @db.Timestamptz
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz

  roles      PlatformUserRole[]
  sessions   PlatformSession[]
  audit_logs PlatformAuditLog[]
  mfa_challenges PlatformMfaChallenge[]

  @@map("platform_users")
}

model PlatformMfaChallenge {
  id String @id @default(uuid()) @db.Uuid
  user_id String @db.Uuid
  purpose String @db.VarChar(10)
  secret_encrypted String? @db.Text
  device_id String? @db.Uuid
  ip_address String? @db.VarChar(45)
  user_agent String? @db.VarChar(512)
  expires_at DateTime @db.Timestamptz
  used_at DateTime? @db.Timestamptz
  attempts Int @default(0)
  created_at DateTime @default(now()) @db.Timestamptz
  user PlatformUser @relation(fields:[user_id],references:[id],onDelete:Cascade)
  @@index([user_id,created_at])
  @@index([expires_at])
  @@map("platform_mfa_challenges")
}

model SecurityRateWindow {
  key String @id @db.VarChar(100)
  count Int @default(0)
  expires_at DateTime @db.Timestamptz
  @@index([expires_at])
  @@map("security_rate_windows")
}

model PlatformRole {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(255)
  description String? @db.Text
  system_role Boolean @default(false)

  role_permissions PlatformRolePermission[]
  user_roles       PlatformUserRole[]

  @@map("platform_roles")
}

model PlatformPermission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(255)
  module      String  @db.VarChar(50)
  resource    String  @db.VarChar(100)
  action      String  @db.VarChar(100)
  description String? @db.Text

  role_permissions PlatformRolePermission[]

  @@map("platform_permissions")
}

model PlatformUserRole {
  user_id String @db.Uuid
  role_id String @db.Uuid

  user PlatformUser @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role PlatformRole @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("platform_user_roles")
}

model PlatformRolePermission {
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  role       PlatformRole       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission PlatformPermission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("platform_role_permissions")
}

model PlatformSession {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  device_id  String?   @db.VarChar(255)
  issued_at  DateTime  @default(now()) @db.Timestamptz
  expires_at DateTime  @db.Timestamptz
  revoked_at DateTime? @db.Timestamptz
  ip_address String?   @db.VarChar(45)
  user_agent String?   @db.VarChar(512)
  last_active_at DateTime @default(now()) @db.Timestamptz

  user PlatformUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("platform_sessions")
}

model PlatformAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  action        String   @db.VarChar(100)
  resource_type String?  @db.VarChar(100)
  resource_id   String?  @db.Uuid
  details       String?  @db.Text
  created_at    DateTime @default(now()) @db.Timestamptz

  user PlatformUser @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([resource_type, resource_id])
  @@index([created_at])
  @@map("platform_audit_logs")
}

// ── Platform Billing & Entitlement Models ────────────────────────────────────

model Plan {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  is_active   Boolean  @default(true)
  monthly_price Decimal @default(0) @db.Decimal(15, 2)
  limits Json @default("{\"users\":5,\"devices\":5,\"branches\":1,\"storage_mb\":100}") @db.JsonB
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz

  organizations Organization[]
  plan_features PlanFeature[]

  @@map("plans")
}

model Feature {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  is_active   Boolean  @default(true)
  rollout_mode String @default("ON") @db.VarChar(20)
  rollout_percent Int @default(100)
  beta_tenants Json @default("[]") @db.JsonB
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz

  plan_features       PlanFeature[]
  tenant_entitlements TenantEntitlement[]

  @@map("features")
}

model PlanFeature {
  plan_id    String @db.Uuid
  feature_id String @db.Uuid

  plan    Plan    @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [feature_id], references: [id], onDelete: Cascade)

  @@id([plan_id, feature_id])
  @@map("plan_features")
}

model TenantEntitlement {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  feature_id      String   @db.Uuid
  is_enabled      Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  feature      Feature      @relation(fields: [feature_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, feature_id], name: "uix_tenant_entitlements")
  @@map("tenant_entitlements")
}

model OwnerInvitation {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  email           String    @db.VarChar(255)
  name            String    @db.VarChar(255)
  token_hash      String    @unique @db.VarChar(255)
  expires_at      DateTime  @db.Timestamptz
  accepted_at     DateTime? @db.Timestamptz
  created_at      DateTime  @default(now()) @db.Timestamptz

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("owner_invitations")
}

model TenantSubscription {
  id String @id @default(uuid()) @db.Uuid
  organization_id String @unique @db.Uuid
  start_date DateTime @db.Timestamptz
  expires_at DateTime @db.Timestamptz
  status String @default("ACTIVE") @db.VarChar(30)
  complimentary Boolean @default(false)
  updated_at DateTime @updatedAt @db.Timestamptz
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  @@map("tenant_subscriptions")
}

model SubscriptionPayment {
  id String @id @default(uuid()) @db.Uuid
  organization_id String @db.Uuid
  amount Decimal @db.Decimal(15, 2)
  tax Decimal @default(0) @db.Decimal(15, 2)
  discount Decimal @default(0) @db.Decimal(15, 2)
  status String @db.VarChar(30)
  method String @db.VarChar(30)
  reference String? @db.VarChar(255)
  period_months Int @default(1)
  plan_name String @db.VarChar(255)
  paid_at DateTime @db.Timestamptz
  refund_amount Decimal @default(0) @db.Decimal(15, 2)
  refund_at DateTime? @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  @@index([organization_id, paid_at])
  @@map("subscription_payments")
}

model PlatformExpense {
  id String @id @default(uuid()) @db.Uuid
  category String @db.VarChar(100)
  amount Decimal @db.Decimal(15, 2)
  expense_date DateTime @db.Date
  method String @db.VarChar(30)
  reference String? @db.VarChar(255)
  note String? @db.Text
  created_by String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz
  @@map("platform_expenses")
}

model PlatformBackup {
  id String @id @default(uuid()) @db.Uuid
  environment String @db.VarChar(50)
  type String @default("MANUAL") @db.VarChar(30)
  status String @db.VarChar(30)
  storage_key String @db.Text
  size_bytes BigInt @default(0)
  verified_at DateTime? @db.Timestamptz
  error String? @db.Text
  created_by String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz
  @@map("platform_backups")
}

model PlatformSupportSession {
  id String @id @default(uuid()) @db.Uuid
  organization_id String @db.Uuid
  platform_user_id String @db.Uuid
  reason String @db.Text
  started_at DateTime @default(now()) @db.Timestamptz
  expires_at DateTime @db.Timestamptz
  ended_at DateTime? @db.Timestamptz
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  @@map("platform_support_sessions")
}

model PlatformAnnouncement {
  id String @id @default(uuid()) @db.Uuid
  title String @db.VarChar(255)
  message String @db.Text
  audience String @db.VarChar(30)
  tenant_ids Json @default("[]") @db.JsonB
  starts_at DateTime @db.Timestamptz
  ends_at DateTime @db.Timestamptz
  priority Int @default(0)
  created_by String @db.Uuid
  @@map("platform_announcements")
}

model PlatformSetting {
  key String @id @db.VarChar(100)
  value Json @db.JsonB
  updated_at DateTime @updatedAt @db.Timestamptz
  @@map("platform_settings")
}

// ── Organization Models ─────────────────────────────────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
  ARCHIVED
}

model MobileOtpChallenge {
  id String @id @default(uuid()) @db.Uuid
  phone_e164 String @db.VarChar(20)
  purpose String @db.VarChar(20)
  user_id String? @db.Uuid
  otp_hash String @db.VarChar(64)
  attempts Int @default(0)
  used_at DateTime? @db.Timestamptz
  expires_at DateTime @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz
  referral_code String? @db.VarChar(40)
  terms_accepted_at DateTime? @db.Timestamptz
  @@index([phone_e164,created_at])
  @@index([expires_at])
  @@map("mobile_otp_challenges")
}

model ReferralCampaign {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(40)
  name String @db.VarChar(200)
  enabled Boolean @default(false)
  reward_type String @default("TRACKING_ONLY") @db.VarChar(30)
  reward_value Decimal @default(0) @db.Decimal(12,2)
  qualification String @default("PAID_SUBSCRIPTION") @db.VarChar(30)
  active_days Int @default(0)
  starts_at DateTime @db.Timestamptz
  ends_at DateTime? @db.Timestamptz
  rules String @db.VarChar(4000)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz
  codes ReferralCode[]
  attributions ReferralAttribution[]
  @@map("referral_campaigns")
}

model ReferralCode {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(40)
  organization_id String? @unique @db.Uuid
  user_id String? @db.Uuid
  campaign_id String? @db.Uuid
  enabled Boolean @default(true)
  created_at DateTime @default(now()) @db.Timestamptz
  organization Organization? @relation(fields:[organization_id],references:[id],onDelete:SetNull)
  user User? @relation(fields:[user_id],references:[id],onDelete:SetNull)
  campaign ReferralCampaign? @relation(fields:[campaign_id],references:[id],onDelete:SetNull)
  attributions ReferralAttribution[]
  @@map("referral_codes")
}

model ReferralAttribution {
  id String @id @default(uuid()) @db.Uuid
  code_id String @db.Uuid
  campaign_id String? @db.Uuid
  referred_user_id String? @unique @db.Uuid
  referred_organization_id String? @unique @db.Uuid
  selected_plan String? @db.VarChar(20)
  status String @default("SIGNED_UP") @db.VarChar(30)
  reward_status String @default("NONE") @db.VarChar(30)
  campaign_snapshot Json @default("{}") @db.JsonB
  fraud_flags Json @default("[]") @db.JsonB
  created_at DateTime @default(now()) @db.Timestamptz
  converted_at DateTime? @db.Timestamptz
  qualified_at DateTime? @db.Timestamptz
  rejected_reason String? @db.VarChar(2000)
  code ReferralCode @relation(fields:[code_id],references:[id],onDelete:Restrict)
  campaign ReferralCampaign? @relation(fields:[campaign_id],references:[id],onDelete:SetNull)
  referred_user User? @relation(fields:[referred_user_id],references:[id],onDelete:SetNull)
  referred_organization Organization? @relation(fields:[referred_organization_id],references:[id],onDelete:SetNull)
  reward ReferralReward?
  @@index([status,created_at])
  @@map("referral_attributions")
}

model ReferralReward {
  id String @id @default(uuid()) @db.Uuid
  attribution_id String @unique @db.Uuid
  beneficiary_organization_id String? @db.Uuid
  type String @db.VarChar(30)
  value Decimal @db.Decimal(12,2)
  status String @db.VarChar(30)
  actor_id String @db.Uuid
  reference String? @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz
  attribution ReferralAttribution @relation(fields:[attribution_id],references:[id],onDelete:Restrict)
  @@index([beneficiary_organization_id,created_at])
  @@map("referral_rewards")
}

model TenantDeletionJob {
  id String @id @default(uuid()) @db.Uuid
  organization_id String @unique @db.Uuid
  actor_id String @db.Uuid
