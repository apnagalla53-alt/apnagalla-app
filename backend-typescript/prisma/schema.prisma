  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  company      Company      @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [created_by], references: [id], onDelete: SetNull)
  expense      Expense?

  @@index([company_id, entity_type, entity_id])
  @@map("attachments")
}

// -- Retail Expense Models ----------------------------------------------------------

model ExpenseCategory {
  id              String @id @default(uuid()) @db.Uuid
  organization_id String @db.Uuid
  company_id      String @db.Uuid

  name      String  @db.VarChar(255)
  icon      String? @db.VarChar(50)
  is_active Boolean @default(true)
  ledger_id String? @db.Uuid

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  organization   Organization   @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  company        Company        @relation(fields: [company_id], references: [id], onDelete: Restrict)
  ledger_account LedgerAccount? @relation(fields: [ledger_id], references: [id], onDelete: SetNull)

  expenses Expense[]

  @@unique([company_id, name])
  @@map("expense_categories")
}

model Expense {
  id              String @id @default(uuid()) @db.Uuid
  organization_id String @db.Uuid
  company_id      String @db.Uuid
  branch_id       String @db.Uuid

  type        String  @db.VarChar(50) // 'BUSINESS_EXPENSE', 'OWNER_WITHDRAWAL'
  category_id String? @db.Uuid

  amount         Decimal  @db.Decimal(15, 6)
  payment_method String   @db.VarChar(50) // 'CASH', 'UPI', 'BANK', 'CARD'
  date           DateTime @db.Date

  paid_to     String? @db.VarChar(255)
  bill_number String? @db.VarChar(100)
  note        String? @db.Text

  status        String  @default("POSTED") @db.VarChar(50) // 'POSTED', 'CANCELLED'
  voucher_id    String? @unique @db.Uuid
  attachment_id String? @unique @db.Uuid

  created_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  organization Organization     @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  company      Company          @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch       Branch           @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  category     ExpenseCategory? @relation(fields: [category_id], references: [id], onDelete: Restrict)
  attachment   Attachment?      @relation(fields: [attachment_id], references: [id], onDelete: SetNull)
  user         User?            @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@index([company_id, branch_id, date])
  @@map("expenses")
}

model RetailCapabilitySettings {
  id                    String  @id @default(uuid()) @db.Uuid
  company_id            String  @unique @db.Uuid
  variants_enabled      Boolean @default(false)
  multi_unit_enabled    Boolean @default(false)
  weight_enabled        Boolean @default(false)
  length_enabled        Boolean @default(false)
  area_enabled          Boolean @default(false)
  batch_enabled         Boolean @default(false)
  serial_enabled        Boolean @default(false)
  images_enabled        Boolean @default(false)
  services_enabled      Boolean @default(false)
  bundles_enabled       Boolean @default(false)
  modifiers_enabled     Boolean @default(false)
  compatibility_enabled Boolean @default(false)
  advanced_pricing      Boolean @default(false)

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("retail_capability_settings")
}

model ItemVariant {
  id                String   @id @default(uuid()) @db.Uuid
  item_id           String   @db.Uuid
  sku               String?  @db.VarChar(100)
  barcode           String?  @db.VarChar(100)
  attributes        Json     @db.JsonB
  purchase_rate     Decimal? @db.Decimal(15, 6)
  mrp               Decimal? @db.Decimal(15, 6)
  default_sale_rate Decimal? @db.Decimal(15, 6)
  is_active         Boolean  @default(true)

  item Item @relation(fields: [item_id], references: [id], onDelete: Cascade)

  stock_movements          StockMovement[]
  stock_balance_projection StockBalanceProjection[]
  sales_invoice_lines      SalesInvoiceLine[]
  purchase_invoice_lines   PurchaseInvoiceLine[]
  pos_held_bill_lines      PosHeldBillLine[]
  sales_return_lines       SalesReturnLine[]
  purchase_return_lines    PurchaseReturnLine[]
  purchase_order_lines     PurchaseOrderLine[]
  goods_receipt_lines      GoodsReceiptLine[]
  sales_quotation_lines    SalesQuotationLine[]
  sales_order_lines        SalesOrderLine[]
  delivery_challan_lines   DeliveryChallanLine[]

  @@index([item_id])
  @@map("item_variants")
}

model ItemUnitConversion {
  id                String  @id @default(uuid()) @db.Uuid
  item_id           String  @db.Uuid
  from_unit_id      String  @db.Uuid
  to_unit_id        String  @db.Uuid
  conversion_factor Decimal @db.Decimal(15, 6)

  item      Item @relation(fields: [item_id], references: [id], onDelete: Cascade)
  from_unit Unit @relation("ConversionFromUnit", fields: [from_unit_id], references: [id], onDelete: Restrict)
  to_unit   Unit @relation("ConversionToUnit", fields: [to_unit_id], references: [id], onDelete: Restrict)

  @@unique([item_id, from_unit_id, to_unit_id], name: "uix_item_unit_conversion")
  @@map("item_unit_conversions")
}

model ItemBatch {
  id                 String    @id @default(uuid()) @db.Uuid
  company_id         String    @db.Uuid
  item_id            String    @db.Uuid
  batch_number       String    @db.VarChar(100)
  manufacturing_date DateTime? @db.Date
  expiry_date        DateTime? @db.Date
  mrp                Decimal?  @db.Decimal(15, 6)
  purchase_rate      Decimal?  @db.Decimal(15, 6)

  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict)
  item    Item    @relation(fields: [item_id], references: [id], onDelete: Cascade)

  stock_movements          StockMovement[]
  stock_balance_projection StockBalanceProjection[]
  sales_invoice_lines      SalesInvoiceLine[]
  purchase_invoice_lines   PurchaseInvoiceLine[]
  pos_held_bill_lines      PosHeldBillLine[]
  sales_return_lines       SalesReturnLine[]
  purchase_return_lines    PurchaseReturnLine[]
  purchase_order_lines     PurchaseOrderLine[]
  goods_receipt_lines      GoodsReceiptLine[]
  sales_quotation_lines    SalesQuotationLine[]

  sales_invoice_batch_allocations SalesInvoiceLineBatchAllocation[]
  sales_return_batch_allocations  SalesReturnLineBatchAllocation[]
  sales_order_lines        SalesOrderLine[]
  delivery_challan_lines   DeliveryChallanLine[]

  @@unique([item_id, batch_number], name: "uix_item_batch_number")
  @@index([company_id])
  @@map("item_batches")
}

model ItemSerial {
  id               String    @id @default(uuid()) @db.Uuid
  company_id       String    @db.Uuid
  godown_id        String?   @db.Uuid
  variant_id       String?   @db.Uuid
  batch_id         String?   @db.Uuid
  received_date    DateTime? @db.Date
  receipt_document_id String? @db.Uuid
  item_id          String    @db.Uuid
  serial_number    String    @db.VarChar(100)
  status           String    @default("AVAILABLE") @db.VarChar(50)
  warranty_start   DateTime? @db.Date
  warranty_end     DateTime? @db.Date
  sold_to_id       String?   @db.Uuid
  sales_invoice_id String?   @db.Uuid

  item          Item          @relation(fields: [item_id], references: [id], onDelete: Cascade)
  sold_to       Party?        @relation(fields: [sold_to_id], references: [id], onDelete: SetNull)
  sales_invoice SalesInvoice? @relation(fields: [sales_invoice_id], references: [id], onDelete: SetNull)

  stock_movements StockMovement[]
  allocations     SerialAllocation[]

  @@unique([item_id, serial_number], name: "uix_item_serial_number")
  @@unique([company_id, serial_number], name: "uix_company_serial_number", map: "uix_company_serial_number")
  @@index([company_id, godown_id, status])
  @@map("item_serials")
}

model ItemBundleComponent {
  id                String  @id @default(uuid()) @db.Uuid
  bundle_item_id    String  @db.Uuid
  component_item_id String  @db.Uuid
  quantity          Decimal @db.Decimal(15, 6)

  bundle_item    Item @relation("BundleItem", fields: [bundle_item_id], references: [id], onDelete: Cascade)
  component_item Item @relation("ComponentItem", fields: [component_item_id], references: [id], onDelete: Restrict)

  @@map("item_bundle_components")
}

model ItemModifierGroup {
  id         String @id @default(uuid()) @db.Uuid
  item_id    String @db.Uuid
  name       String @db.VarChar(100)
  min_select Int    @default(0)
  max_select Int    @default(1)

  item    Item                 @relation(fields: [item_id], references: [id], onDelete: Cascade)
  options ItemModifierOption[]

  @@map("item_modifier_groups")
}

model ItemModifierOption {
  id                String  @id @default(uuid()) @db.Uuid
  modifier_group_id String  @db.Uuid
  name              String  @db.VarChar(100)
  price_delta       Decimal @default(0) @db.Decimal(15, 6)

  group ItemModifierGroup @relation(fields: [modifier_group_id], references: [id], onDelete: Cascade)

  @@map("item_modifier_options")
}

model VariantOptionDefinition {
  id         String @id @default(uuid()) @db.Uuid
  company_id String @db.Uuid
  name       String @db.VarChar(100)
  values     Json   @db.JsonB

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, name], name: "uix_variant_option_name")
  @@map("variant_option_definitions")
}

model SerialAllocation {
  id                   String @id @default(uuid()) @db.Uuid
  company_id           String @db.Uuid
  serial_id            String @db.Uuid
  source_document_type String @db.VarChar(100)
  source_document_id   String @db.Uuid
  source_line_id       String @db.Uuid
  warranty_snapshot    Json? @db.JsonB
  returned_at          DateTime?
  return_document_id   String? @db.Uuid

  serial             ItemSerial        @relation(fields: [serial_id], references: [id], onDelete: Restrict)
  company            Company           @relation(fields: [company_id], references: [id], onDelete: Cascade)
  sales_invoice_line SalesInvoiceLine? @relation(fields: [source_line_id], references: [id], map: "fk_sil_sa", onDelete: Cascade)

  @@index([source_document_type, source_document_id])
  @@map("serial_allocations")
}

model RetailImportJob {
  id String @id @default(uuid()) @db.Uuid
  company_id String @db.Uuid
  branch_id String @db.Uuid
  financial_year_id String @db.Uuid
  user_id String @db.Uuid
  preset String @db.VarChar(30)
  kind String @db.VarChar(30)
  filename String @db.VarChar(255)
  fingerprint String @db.VarChar(64)
  configuration Json @db.JsonB
  headers Json @db.JsonB
  status String @default("PREVIEW") @db.VarChar(30)
  created_at DateTime @default(now()) @db.Timestamptz
  company Company @relation(fields:[company_id],references:[id],onDelete:Restrict)
  branch Branch @relation(fields:[branch_id],references:[id],onDelete:Restrict)
  financial_year FinancialYear @relation(fields:[financial_year_id],references:[id],onDelete:Restrict)
  user User @relation(fields:[user_id],references:[id],onDelete:Restrict)
  rows RetailImportRow[]
  @@unique([company_id,branch_id,fingerprint])
  @@index([company_id,created_at])
  @@map("retail_import_jobs")
}
model RetailImportRow {
  id String @id @default(uuid()) @db.Uuid
  job_id String @db.Uuid
  number Int
  source Json @db.JsonB
  normalized Json @db.JsonB
  errors Json @db.JsonB
  status String @default("READY") @db.VarChar(30)
  entity_id String? @db.Uuid
  job RetailImportJob @relation(fields:[job_id],references:[id],onDelete:Cascade)
  @@unique([job_id,number])
  @@index([job_id,status,number])
  @@map("retail_import_rows")
}
model RetailImportIdentity {
  id String @id @default(uuid()) @db.Uuid
  company_id String @db.Uuid
  kind String @db.VarChar(30)
  source_key String @db.VarChar(64)
  entity_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz
  company Company @relation(fields:[company_id],references:[id],onDelete:Restrict)
  @@unique([company_id,kind,source_key])
  @@map("retail_import_identities")
}
model RetailMigrationChoice {
  id String @id @default(uuid()) @db.Uuid
  company_id String @db.Uuid
  user_id String @db.Uuid
  choice String @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz
  company Company @relation(fields:[company_id],references:[id],onDelete:Restrict)
  user User @relation(fields:[user_id],references:[id],onDelete:Restrict)
  @@unique([company_id,user_id])
  @@map("retail_migration_choices")
}
model RetailReportPreference {
  id String @id @default(uuid()) @db.Uuid
  company_id String @db.Uuid
  branch_id String @db.Uuid
  user_id String @db.Uuid
  enabled Boolean @default(false)
  time String @default("19:30") @db.VarChar(5)
  language String @default("hi") @db.VarChar(5)
  created_at DateTime @default(now()) @db.Timestamptz
  company Company @relation(fields:[company_id],references:[id],onDelete:Restrict)
  branch Branch @relation(fields:[branch_id],references:[id],onDelete:Restrict)
  user User @relation(fields:[user_id],references:[id],onDelete:Restrict)
  @@unique([company_id,branch_id,user_id])
  @@index([enabled,time])
  @@map("retail_report_preferences")
}
model RetailReportNotification {
  id String @id @default(uuid()) @db.Uuid
  company_id String @db.Uuid
  branch_id String @db.Uuid
  user_id String @db.Uuid
  day String @db.VarChar(10)
  summary Json @db.JsonB
  read_at DateTime? @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz
  company Company @relation(fields:[company_id],references:[id],onDelete:Restrict)
  branch Branch @relation(fields:[branch_id],references:[id],onDelete:Restrict)
  user User @relation(fields:[user_id],references:[id],onDelete:Restrict)
  @@unique([company_id,branch_id,user_id,day])
  @@index([company_id,user_id,created_at])
  @@map("retail_report_notifications")
}
model RetailDataBackupRequest {
  id String @id @default(uuid()) @db.Uuid
  company_id String @db.Uuid
  user_id String @db.Uuid
  request_key String @db.VarChar(64)
  status String @default("REQUESTED") @db.VarChar(30)
  contacted_at DateTime? @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz
  company Company @relation(fields:[company_id],references:[id],onDelete:Restrict)
  user User @relation(fields:[user_id],references:[id],onDelete:Restrict)
  @@unique([company_id,user_id,request_key])
  @@index([contacted_at,created_at])
  @@map("retail_data_backup_requests")
}

// One WAC pool per company/item/variant; physical locations remain in Inventory.
model InventoryCostState {
  company Company @relation(fields:[company_id],references:[id],onDelete:Restrict,onUpdate:NoAction)
  item Item @relation(fields:[item_id],references:[id],onDelete:Cascade)
  id String @id @default(uuid()) @db.Uuid
  company_id String @db.Uuid
  item_id String @db.Uuid
  variant_key String @db.VarChar(40)
  quantity Decimal @default(0) @db.Decimal(24, 12)
  unknown_quantity Decimal @default(0) @db.Decimal(24, 12)
  known_value Decimal @default(0) @db.Decimal(24, 12)
  updated_at DateTime @updatedAt @db.Timestamptz
  @@unique([company_id,item_id,variant_key])
  @@index([company_id,item_id])
  @@map("inventory_cost_states")
}
