  notes                  String?   @db.Text
  total                  Decimal   @default(0) @db.Decimal(15, 6)

  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch  Branch  @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  party   Party   @relation(fields: [party_id], references: [id], onDelete: Restrict)

  lines          PurchaseOrderLine[]
  goods_receipts GoodsReceipt[]

  @@index([document_number])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                String  @id @default(uuid()) @db.Uuid
  purchase_order_id String  @db.Uuid
  item_id           String  @db.Uuid
  unit_id           String  @db.Uuid
  ordered_quantity  Decimal @db.Decimal(15, 6)
  received_quantity Decimal @default(0) @db.Decimal(15, 6)
  free_quantity     Decimal @default(0) @db.Decimal(15, 6)
  rate              Decimal @db.Decimal(15, 6)
  discount          Decimal @default(0) @db.Decimal(15, 6)
  tax               Decimal @default(0) @db.Decimal(15, 6)
  line_total        Decimal @default(0) @db.Decimal(15, 6)

  purchase_order PurchaseOrder @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  item           Item          @relation(fields: [item_id], references: [id], onDelete: Restrict)

  entered_quantity  Decimal? @db.Decimal(15, 6)
  entered_unit_id   String?  @db.Uuid
  conversion_factor Decimal? @db.Decimal(15, 6)
  base_quantity     Decimal? @db.Decimal(15, 6)
  variant_id        String?  @db.Uuid
  batch_id          String?  @db.Uuid
  serial_ids        Json?    @db.JsonB
  dimensions        Json?    @db.JsonB
  modifiers         Json?    @db.JsonB

  entered_unit Unit?        @relation("LineEnteredUnit", fields: [entered_unit_id], references: [id], onDelete: Restrict)
