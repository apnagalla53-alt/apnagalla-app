# Template only: replace domains, TLS paths and frontend root before validation.
# Place limit_req_zone directives in nginx's http context.
limit_req_zone $binary_remote_addr zone=evolix_login:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=evolix_upload:10m rate=30r/m;
server {
  listen 443 ssl;
  server_name retail.example.invalid;
  ssl_certificate /operator/configured/fullchain.pem;
  ssl_certificate_key /operator/configured/private.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  root /operator/configured/evolix/frontend/dist;
  client_max_body_size 6m;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Cross-Origin-Opener-Policy same-origin-allow-popups always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self'; connect-src 'self' https://accounts.google.com; frame-src 'self' https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
  location ~ ^/api/v1/(platform/)?auth/ {
    limit_req zone=evolix_login burst=10 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:8010;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
  }
  location = /api/v1/attachments {
    limit_req zone=evolix_upload burst=10 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:8010;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
  }
  location /api/v1/ {
    proxy_pass http://127.0.0.1:8010;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 30s;
  }
  location / { try_files $uri $uri/ /index.html; }
}
