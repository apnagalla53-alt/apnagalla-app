# TEMPLATE ONLY: review and copy to render.yaml in the repository root.
# Creating this service incurs the selected provider plan's charges.
# Apply migrations through a SEPARATE operator job before starting the API.
services:
  - type: web
    name: apna-galla-api-staging
    runtime: docker
    plan: starter
    rootDir: backend-typescript
    dockerfilePath: ./Dockerfile
    dockerContext: .
    autoDeployTrigger: "off"
    healthCheckPath: /api/v1/health/ready
    envVars:
      - key: NODE_ENV
        value: production
      # Keep aligned with this image's internal Docker health check.
      - key: PORT
        value: "8010"
      - key: DATABASE_URL
        sync: false
      - key: JWT_SECRET
        sync: false
      - key: PLATFORM_JWT_SECRET
        sync: false
      - key: MFA_ENCRYPTION_KEY
        sync: false
      - key: FRONTEND_ORIGIN
        sync: false
      - key: API_ORIGIN
        sync: false
      - key: PUBLIC_APP_URL
        sync: false
      - key: APP_VERSION
        sync: false
      - key: TRUSTED_PROXY_CIDRS
        sync: false
      - key: STORAGE_PROVIDER
        value: s3
      - key: S3_BUCKET
        sync: false
      - key: S3_REGION
        sync: false
      - key: AWS_ACCESS_KEY_ID
        sync: false
      - key: AWS_SECRET_ACCESS_KEY
        sync: false
      - key: BACKUP_PROVIDER
        value: none
      - key: EMAIL_PROVIDER
        value: none
      - key: SMS_PROVIDER
        value: none
      - key: ANDROID_APP_ENABLED
        value: "false"
      - key: GOOGLE_CLIENT_ID
        sync: false
# BACKUP_PROVIDER=none / EMAIL_PROVIDER=none permit staging startup, not customer launch.
# Add the actual SMTP and encrypted offsite backup configuration before production.
# Never inject Neon owner/migration credentials into this API environment.
