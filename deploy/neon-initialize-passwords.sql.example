-- OPTIONAL OPERATOR STEP: only for the two NEW, UNUSED passwordless roles.
-- Do not run this after either role is in use: it replaces their passwords.
-- Run in Neon SQL Editor as the trusted project database administrator.
-- Passwords are generated in PostgreSQL and never returned to the editor.
-- After successful initialization, use Console Reset password for each role
-- and save those FINAL generated passwords privately before deployment.
DO $$
DECLARE
  role_name text;
  generated_password text;
BEGIN
  FOREACH role_name IN ARRAY ARRAY['evolix_migrator', 'evolix_runtime']
  LOOP
    IF NOT EXISTS (
      SELECT FROM pg_roles WHERE rolname=role_name AND rolcanlogin
        AND NOT rolsuper AND NOT rolbypassrls AND NOT rolcreatedb AND NOT rolcreaterole
    ) THEN
      RAISE EXCEPTION 'Expected new restricted login role is missing or has elevated flags';
    END IF;
  END LOOP;
  FOREACH role_name IN ARRAY ARRAY['evolix_migrator', 'evolix_runtime']
  LOOP
    generated_password := replace(gen_random_uuid()::text, '-', '')
                       || replace(gen_random_uuid()::text, '-', '');
    EXECUTE format('ALTER ROLE %I PASSWORD %L', role_name, generated_password);
  END LOOP;
END $$;
