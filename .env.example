# EVOLIX Trade ERP — Environment Configuration
# Current runtimes: backend-typescript and frontend.
# Copy backend-typescript/.env.example to backend-typescript/.env for development.
# Use backend-typescript/.env.production.example and a secret manager in production.
# This root file documents legacy Python configuration only; it is not read by Nest.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────
APP_NAME=EVOLIX Trade ERP
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development
DOCS_ENABLED=true

# ── Database ─────────────────────────────────────────────────
# Use EVOLIX-specific local PostgreSQL databases ONLY.
# NEVER connect to production/customer databases from development.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
DATABASE_NAME=evolix_trade_dev

# ── CORS ─────────────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
